# UniFi Controller Configuration
# Copy this file to .env and fill in your actual values.
# hlp reads .env from the directory you run it in (or the file given with
# --env-file, or named by the HLP_ENV environment variable).
# List each variable once: if one appears on several lines the last one is used, and a variable already set in
# your shell wins over this file. `hlp doctor` checks for both, and for misspelled names.

# UniFi Controller URL (include protocol and port). Must be https:// (see ALLOW_INSECURE_HTTP).
UNIFI_URL=https://192.168.1.1:443

# API Key from Settings > Control Plane > Integrations.
# This is a credential: keep this file private with `chmod 600 .env`
# (hlp warns if other users can read it).
UNIFI_API_KEY=your-api-key-here

# Site: name, internal reference or UUID (usually 'default').
# No / \ ? # or control characters, at most 128 characters.
UNIFI_SITE_ID=default

# SSL certificate verification: true/yes/1/on or false/no/0/off.
# Leave this on. A UniFi controller usually has a self-signed certificate: if the first run
# fails with "TLS certificate verification failed", trust that certificate (see below), install
# a trusted one on the controller, or as a last resort set this to false (the API key is then
# sent without checking who answers).
UNIFI_VERIFY_SSL=true
# Better than false: trust the CA that signed the controller certificate, e.g.
# UNIFI_VERIFY_SSL=/home/me/unifi-ca.pem. Some UniFi self-signed leaf certificates
# are not valid CA bundles; in that case install a proper certificate or use false.

# Seconds to wait for each request (1 to 600). Raise it for a slow gateway; --timeout overrides it.
# UNIFI_TIMEOUT=15

# How many requests to make at once (1 to 16; 1 means one by one). --parallel overrides it.
# UNIFI_PARALLEL_REQUESTS=6

# What the tool says about itself on stderr (see docs/logging.md). LOG_LEVEL is DEBUG, INFO, WARNING (the default)
# or ERROR; --verbose means DEBUG. LOG_FORMAT=text or json gives one record per line with fields; leave it unset
# to keep the command-line format.
# LOG_LEVEL=WARNING
# LOG_FORMAT=json

# The web interface's audit log (audit.log, one JSON line per change to the accounts): the size of one file in
# megabytes (1 to 1024) and how many files are kept in all (2 to 1000). `hlp web-user` reads these from the
# environment, not from this file.
# AUDIT_LOG_MAX_MB=5
# AUDIT_LOG_FILES=10

# The web interface's login: a session ends after this many minutes without a request (1 to 1440) and in any case
# after this many hours (1 to 720).
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12

# Lab networks only: allow an http:// UNIFI_URL, which sends the API key in clear text.
# Leave this unset (false) unless you understand the risk.
# ALLOW_INSECURE_HTTP=false

# Notifications for `diagnose --notify` (optional). The URLs and tokens are secrets, like UNIFI_API_KEY.
# A public ntfy.sh topic can be read by anyone who knows its name: use a long random one or your own server.
# NOTIFY_NTFY_URL=https://ntfy.example.com/a-long-random-topic-name
# NOTIFY_NTFY_TOKEN=
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/in/abc123
# NOTIFY_WEBHOOK_TOKEN=
# Email: setting NOTIFY_SMTP_HOST turns it on (NOTIFY_EMAIL_FROM and NOTIFY_EMAIL_TO are then required, several
# recipients separated by commas). The connection uses verified STARTTLS (port 587) by default or implicit TLS
# with NOTIFY_SMTP_SECURITY=ssl (port 465). Plain SMTP is lab-only and never permits a password. A user and
# password go together; use an app password for a provider.
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_SECURITY=starttls
# NOTIFY_SMTP_USER=alerts@example.com
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=alerts@example.com
# NOTIFY_EMAIL_TO=me@example.com

# UniFi Controller Configuration
# Copy this file to .env and fill in your actual values.
# unifi-sentinel reads .env from the directory you run it in (or the file given with
# --env-file, or named by the UNIFI_SENTINEL_ENV environment variable).

# UniFi Controller URL (include protocol and port). Must be https:// (see ALLOW_INSECURE_HTTP).
CONTROLLER_URL=https://192.168.1.1:443

# API Key from Settings > Control Plane > Integrations.
# This is a credential: keep this file private with `chmod 600 .env`
# (unifi-sentinel warns if other users can read it).
API_KEY=your-api-key-here

# Site: name, internal reference or UUID (usually 'default').
# No / \ ? # or control characters, at most 128 characters.
SITE_ID=default

# SSL Certificate Verification: true/yes/1/on or false/no/0/off
# Set to false if using self-signed certificates
VERIFY_SSL=false

# Lab networks only: allow an http:// CONTROLLER_URL, which sends the API key in clear text.
# Leave this unset (false) unless you understand the risk.
# ALLOW_INSECURE_HTTP=false

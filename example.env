# UniFi Controller Configuration
# Copy this file to .env and fill in your actual values.
# unifi-sentinel reads .env from the directory you run it in (or the file given with
# --env-file, or named by the UNIFI_SENTINEL_ENV environment variable).

# UniFi Controller URL (include protocol and port). Must be https:// (see ALLOW_INSECURE_HTTP).
CONTROLLER_URL=https://192.168.1.1:443

# API Key from Settings > Control Plane > Integrations.
# This is a credential: keep this file private with `chmod 600 .env`
# (unifi-sentinel warns if other users can read it).
API_KEY=your-api-key-here

# Site: name, internal reference or UUID (usually 'default').
# No / \ ? # or control characters, at most 128 characters.
SITE_ID=default

# SSL certificate verification: true/yes/1/on or false/no/0/off.
# Leave this on. A UniFi controller usually has a self-signed certificate: if the first run
# fails with "TLS certificate verification failed", trust that certificate (see below), install
# a trusted one on the controller, or as a last resort set this to false (the API key is then
# sent without checking who answers).
VERIFY_SSL=true
# Better than false: trust the controller's own certificate by pointing at its PEM file
# (or the CA that signed it), e.g. VERIFY_SSL=/home/me/unifi-ca.pem

# Seconds to wait for each request (1 to 600). Raise it for a slow gateway; --timeout overrides it.
# TIMEOUT=15

# Lab networks only: allow an http:// CONTROLLER_URL, which sends the API key in clear text.
# Leave this unset (false) unless you understand the risk.
# ALLOW_INSECURE_HTTP=false

# Notifications for `diagnose --notify` (optional). The URLs and tokens are secrets, like API_KEY.
# A public ntfy.sh topic can be read by anyone who knows its name: use a long random one or your own server.
# NOTIFY_NTFY_URL=https://ntfy.example.com/a-long-random-topic-name
# NOTIFY_NTFY_TOKEN=
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/in/abc123
# NOTIFY_WEBHOOK_TOKEN=

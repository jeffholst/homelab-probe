[
  {
    "name": "plain",
    "input": "Living room AP",
    "limit": 0,
    "expected": "Living room AP"
  },
  {
    "name": "empty",
    "input": "",
    "limit": 0,
    "expected": ""
  },
  {
    "name": "spaces only",
    "input": "   ",
    "limit": 0,
    "expected": ""
  },
  {
    "name": "tab and newline become one space",
    "input": "a\t\n\r b",
    "limit": 0,
    "expected": "a  b"
  },
  {
    "name": "several line breaks collapse",
    "input": "a\n\n\nb",
    "limit": 0,
    "expected": "a b"
  },
  {
    "name": "next line, line and paragraph separators",
    "input": "a\u0085b\u2028c\u2029d",
    "limit": 0,
    "expected": "a b c d"
  },
  {
    "name": "nul and bell",
    "input": "a\u0000b\u0007c",
    "limit": 0,
    "expected": "abc"
  },
  {
    "name": "escape sequence",
    "input": "x\u001b[31mred\u001b[0m",
    "limit": 0,
    "expected": "x[31mred[0m"
  },
  {
    "name": "vertical tab and form feed",
    "input": "a\u000bb\fc",
    "limit": 0,
    "expected": "abc"
  },
  {
    "name": "delete and C1 controls",
    "input": "a\u007fb\u0080c\u009fd",
    "limit": 0,
    "expected": "abcd"
  },
  {
    "name": "right-to-left override",
    "input": "gpj.\u202eexe.txt",
    "limit": 0,
    "expected": "gpj.exe.txt"
  },
  {
    "name": "every embedding and override",
    "input": "\u202a\u202b\u202c\u202d\u202eX",
    "limit": 0,
    "expected": "X"
  },
  {
    "name": "isolates",
    "input": "a\u2066b\u2067c\u2068d\u2069e",
    "limit": 0,
    "expected": "abcde"
  },
  {
    "name": "zero-width space",
    "input": "ad\u200bmin",
    "limit": 0,
    "expected": "admin"
  },
  {
    "name": "word joiner and invisible operators",
    "input": "a\u2060b\u2061c\u2062d\u2063e\u2064f",
    "limit": 0,
    "expected": "abcdef"
  },
  {
    "name": "byte-order mark",
    "input": "\ufeffname",
    "limit": 0,
    "expected": "name"
  },
  {
    "name": "zero-width joiner is kept (emoji)",
    "input": "\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67",
    "limit": 0,
    "expected": "\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67"
  },
  {
    "name": "zero-width non-joiner is kept (Persian)",
    "input": "\u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645",
    "limit": 0,
    "expected": "\u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645"
  },
  {
    "name": "weak direction marks are kept",
    "input": "a\u200eb\u200fc\u061cd",
    "limit": 0,
    "expected": "a\u200eb\u200fc\u061cd"
  },
  {
    "name": "right-to-left letters are kept",
    "input": "\u05e9\u05dc\u05d5\u05dd",
    "limit": 0,
    "expected": "\u05e9\u05dc\u05d5\u05dd"
  },
  {
    "name": "markup is text, not removed",
    "input": "<img src=x onerror=alert(1)>",
    "limit": 0,
    "expected": "<img src=x onerror=alert(1)>"
  },
  {
    "name": "surrounding hidden characters are trimmed",
    "input": "\u200b  name \u202e",
    "limit": 0,
    "expected": "name"
  },
  {
    "name": "non-breaking space is trimmed at the ends",
    "input": "\u00a0name\u00a0",
    "limit": 0,
    "expected": "name"
  },
  {
    "name": "limit shorter than the text",
    "input": "abcdefghij",
    "limit": 5,
    "expected": "abcd\u2026"
  },
  {
    "name": "limit equal to the length",
    "input": "abcde",
    "limit": 5,
    "expected": "abcde"
  },
  {
    "name": "limit counts characters, not UTF-16 units",
    "input": "\ud83d\ude00\ud83d\ude01\ud83d\ude02\ud83d\ude03",
    "limit": 3,
    "expected": "\ud83d\ude00\ud83d\ude01\u2026"
  },
  {
    "name": "limit applies after cleaning",
    "input": "ab\u200bcdef",
    "limit": 4,
    "expected": "abc\u2026"
  },
  {
    "name": "limit of one",
    "input": "abc",
    "limit": 1,
    "expected": "\u2026"
  }
]

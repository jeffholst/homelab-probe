{
  "$id": "urn:homelab-probe:terminal-error.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "candidates": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    },
    "correlationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlationid"
    },
    "error": {
      "title": "Error",
      "type": "string"
    },
    "executionStatus": {
      "anyOf": [
        {
          "enum": [
            "did_not_run",
            "failed",
            "outcome_unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executionstatus"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "retry_after": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry After"
    }
  },
  "required": [
    "error",
    "message"
  ],
  "title": "TerminalError",
  "type": "object"
}
